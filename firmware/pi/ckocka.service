[Unit]
Description=C-kocka – asztali AI-asszisztens
After=sound.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/ckocka
ExecStart=/opt/ckocka/venv/bin/python -m ckocka
# az ANTHROPIC_API_KEY innen jön (root-only fájl a Pi-n, NEM a repóban); ha nincs, a kocka beszélgetés nélkül fut
EnvironmentFile=-/etc/ckocka.env
Restart=always
RestartSec=3
# párosító kód az apphoz (ha üres, a helyi hálózaton bárki csatlakozhat)
Environment=CKOCKA_TOKEN=
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
